[Unit]
Description=Bare Cedar Fog infomaterial patch-cover assembly A2A provider
After=network-online.target witness-journal-rdf-projection-service.service
Wants=network-online.target
Requires=witness-journal-rdf-projection-service.service

[Service]
Type=simple
WorkingDirectory=/home/emsenn/info/lib/emsenn/services/561-group/services/lenticule-science/services/obsmetrological-services-section/services/infomaterial-patch-cover
Environment=HOST=127.0.0.1
Environment=PORT=19838
Environment=BASE_URL=http://127.0.0.1:19838
Environment=WITNESS_JOURNAL_RDF_AGENT=http://127.0.0.1:19764/.well-known/agent-card.json
Environment=AGENT_CARD_SIGNING_KEY=/home/emsenn/info/lib/emsenn/services/561-group/services/lenticule-science/services/obsmetrological-services-section/services/infomaterial-patch-cover/data/agent-card-signing/ed25519-private.pem
Environment=AGENT_CARD_JWKS=/home/emsenn/info/lib/emsenn/services/561-group/services/lenticule-science/services/obsmetrological-services-section/services/infomaterial-patch-cover/content/agent-card-signing/jwks.json
Environment=AGENT_CARD_SIGNING_KID=infomaterial-patch-cover-2026-07-21
ExecStart=/home/emsenn/.config/nvm/versions/node/v24.13.1/bin/node bin/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/emsenn/info/lib/emsenn/services/561-group/services/lenticule-science/services/obsmetrological-services-section/services/infomaterial-patch-cover/data

[Install]
WantedBy=default.target
