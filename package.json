{
  "name": "@lenticule-science/infomaterial-patch-cover",
  "version": "3.0.2",
  "private": true,
  "type": "module",
  "description": "Pure gap-free recursive cover assembly from a shallow plate receipt and independently observed child patches.",
  "exports": {
    ".": "./src/directory-cover.mjs",
    "./directory-cover": "./src/directory-cover.mjs",
    "./client": "./src/client.mjs",
    "./evidence": "./src/patch-evidence.mjs",
    "./evidence-client": "./src/evidence-client.mjs",
    "./receipt": "./src/cover-receipt.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "serve-directory-patch-cover-a2a": "./scripts/server.mjs",
    "solicit-service": "./src/contract-directory-cover.mjs",
    "invoke-service": "./src/contract-directory-cover.mjs"
  },
  "scripts": {
    "check": "node --check src/directory-cover.mjs && node --check src/cover-receipt.mjs && node --check src/patch-evidence.mjs && node --check src/evidence-client.mjs && node --check src/client.mjs && node --check src/contract-directory-cover.mjs && node --check scripts/execute-a2a-task.mjs && node --check scripts/server.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.0.0-beta.0",
    "@red-cup-engineering/a2a-contracted-agent-service": "2.0.5",
    "@red-cup-engineering/a2a-rmn-part-service": "1.0.1",
    "@red-cup-engineering/a2a-rmn-task-client-service": "1.1.1",
    "@lenticule-science/infomaterial-directory-plate-observation": "2.0.1",
    "@lenticule-science/infomaterial-observation": "2.0.2",
    "@red-cup-engineering/semantic-content-identify-service": "0.2.2",
    "@red-cup-engineering/relation-model-notation-runtime": "7.0.0",
    "@red-cup-engineering/witness-journal-rdf-projection-service": "1.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lenticule-science/infomaterial-patch-cover.git"
  }
}
